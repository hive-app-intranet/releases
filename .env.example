# HIVE — production environment.
#
# Copy this file to .env and fill in the values below, then either:
#   docker compose up -d --build     (recommended — bundles Postgres + storage)
#   npm run setup && npm start        (bring your own Postgres/storage)
#
# See README.md for the full install walkthrough.

# The one process serves both the API and the built UI on this single port.
APP_PORT=4000

# One process, one secret — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL — this install's own database, one role.
# With docker-compose.yml as shipped, POSTGRES_HOST is the "postgres"
# service name. Running the api outside Docker against your own Postgres?
# Point this at that host instead (e.g. 127.0.0.1, or a managed instance).
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=hive_db
POSTGRES_PORT=5432

# Storage — fixed at install time, never switched live. STORAGE_PROVIDER
# picks the backend; STORAGE_BUCKET is common to every provider; every
# other STORAGE_* var below is namespaced per provider, and only the group
# matching STORAGE_PROVIDER is ever read. Each provider needs a different
# set of variables — see its own comment below for exactly which ones.
#
# Supported values:
#   s3        Amazon S3, or anything speaking the same S3 protocol.
#   gcs       Google Cloud Storage.
#   azure     Azure Blob Storage.
#   supabase  Supabase Storage.
#   local     The SeaweedFS service bundled in docker-compose.yml.
#             DEV/TEST ONLY — not a durable backend for production, it's
#             only there so you can try HIVE out with no cloud account.
#
# The value shipped below (s3, pointed at the bundled SeaweedFS through
# STORAGE_AWS_ENDPOINT) is that same dev/test setup, just using the s3
# driver instead of a separate "local" provider — SeaweedFS speaks the S3
# protocol, so this is the same thing "local" would give you. For a real
# install, replace this whole block with real S3/GCS/Azure/Supabase
# credentials before going to production.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=hive
STORAGE_LOCAL_PORT=8333

# s3 — used both for real AWS S3 and for the bundled SeaweedFS above
# (STORAGE_AWS_ENDPOINT set = self-hosted; unset = real AWS S3). With
# docker-compose.yml as shipped, the endpoint is the "seaweedfs" service
# name; running outside Docker, use 127.0.0.1 instead. Required:
# STORAGE_AWS_REGION. Optional (unset = AWS SDK's own default credential
# chain, only resolves on AWS compute): STORAGE_AWS_ENDPOINT,
# STORAGE_AWS_ACCESS_KEY, STORAGE_AWS_SECRET_KEY.
STORAGE_AWS_REGION=us-east-1
STORAGE_AWS_ENDPOINT=http://seaweedfs:8333
STORAGE_AWS_ACCESS_KEY=admin
STORAGE_AWS_SECRET_KEY=admin

# gcs — Google Cloud Storage. Nothing required; both optional (unset =
# Application Default Credentials, only resolves on GCP compute):
# STORAGE_GCS_PROJECT_ID, STORAGE_GCS_CREDENTIALS_JSON.
# STORAGE_GCS_PROJECT_ID=
# STORAGE_GCS_CREDENTIALS_JSON=

# azure — Azure Blob Storage. Set STORAGE_AZURE_CONNECTION_STRING, or
# STORAGE_AZURE_ACCOUNT_NAME alone to fall back to Managed Identity (only
# resolves on Azure compute) — one of the two is required.
# STORAGE_AZURE_CONNECTION_STRING=
# STORAGE_AZURE_ACCOUNT_NAME=

# supabase — Supabase Storage. A third-party hosted service, not compute
# infrastructure this process could ever run "inside" — every field below
# is required: STORAGE_SUPABASE_ENDPOINT, STORAGE_SUPABASE_REGION,
# STORAGE_SUPABASE_ACCESS_KEY, STORAGE_SUPABASE_SECRET_KEY.
# STORAGE_SUPABASE_ENDPOINT=
# STORAGE_SUPABASE_REGION=
# STORAGE_SUPABASE_ACCESS_KEY=
# STORAGE_SUPABASE_SECRET_KEY=

# There is no LICENSE var here — running `npm run setup` (or `npx hive
# setup`) asks whether you have a license token to paste; leaving it blank
# runs the free, unlicensed build (an implicit "standard" plan). See
# README.md's "License" section.
